# Vercel build setting (public API URL, never a secret).
WISELANKA_API_BASE=https://your-api.onrender.com

# Render runtime setting: comma-separated, exact frontend origins, without paths.
WISELANKA_CORS_ORIGINS=https://your-site.vercel.app

# These settings belong in each hosting dashboard. Local Python does not
# automatically load this file. Local defaults use ports 5500/5501 and 8000.
